{
  "request": {
    "method": "PATCH",
    "url": "https://webexapis.com/v1/deviceConfigurations?deviceId=test-device-id",
    "headers": {
      "Authorization": "Bearer <REDACTED>",
      "Content-Type": "application/json-patch+json"
    },
    "body": "[{\"op\": \"replace\", \"path\": \"Audio.DefaultVolume/sources/configured/value\", \"value\": 50}]"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "deviceId": "test-device-id",
      "items": {
        "Audio.DefaultVolume": {
          "value": 50,
          "sources": {
            "configured": {
              "value": 50
            }
          },
          "valueSpace": {
            "type": "integer"
          },
          "appliedConfigurationValue": {
            "value": 50
          }
        }
      }
    }
  }
}
