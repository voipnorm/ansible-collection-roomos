  "modules": [
    {
      "fqcn": "voipnorm.roomos.roomos_command",
      "blockType": "voipnorm_roomos_command",
      "label": "roomos_command",
      "tooltip": "Execute xCommands on Cisco RoomOS devices",
      "helpUrl": "https://github.com/voipnorm/ansible-collection-roomos",
      "structure": { "type": "flat" },
      "fields": [
        {
          "key": "command",
          "fieldId": "COMMAND",
          "label": "Command",
          "type": "text",
          "required": true,
          "placeholder": "SystemUnit.Boot",
          "description": "xCommand path in dot notation"
        },
        {
          "key": "arguments",
          "fieldId": "ARGUMENTS",
          "label": "Arguments",
          "type": "text",
          "yamlType": "dict",
          "placeholder": "Action: Restart",
          "description": "Command arguments as key: value pairs"
        },
        {
          "key": "transport",
          "fieldId": "TRANSPORT",
          "label": "Transport",
          "type": "dropdown",
          "default": "local",
          "options": [["cloud", "cloud"], ["local", "local"]]
        },
        {
          "key": "device_id",
          "fieldId": "DEVICE_ID",
          "label": "Device ID",
          "type": "text",
          "visibleWhen": { "TRANSPORT": "cloud" },
          "placeholder": "Webex device ID"
        },
        {
          "key": "token",
          "fieldId": "TOKEN",
          "label": "Token",
          "type": "text",
          "visibleWhen": { "TRANSPORT": "cloud" },
          "placeholder": "{{ webex_token }}"
        },
        {
          "key": "host",
          "fieldId": "HOST",
          "label": "Host",
          "type": "text",
          "visibleWhen": { "TRANSPORT": "local" },
          "placeholder": "{{ ansible_host }}"
        },
        {
          "key": "username",
          "fieldId": "USERNAME",
          "label": "Username",
          "type": "text",
          "visibleWhen": { "TRANSPORT": "local" },
          "placeholder": "admin"
        },
        {
          "key": "password",
          "fieldId": "PASSWORD",
          "label": "Password",
          "type": "text",
          "visibleWhen": { "TRANSPORT": "local" },
          "placeholder": "{{ device_password }}"
        },
        {
          "key": "validate_certs",
          "fieldId": "VALIDATE_CERTS",
          "label": "Validate Certs",
          "type": "boolean",
          "default": false,
          "advanced": true
        },
        {
          "key": "timeout",
          "fieldId": "TIMEOUT",
          "label": "Timeout",
          "type": "number",
          "default": 30,
          "advanced": true
        }
      ]
    },
    {
