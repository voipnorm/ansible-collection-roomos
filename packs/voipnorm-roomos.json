          "yamlKey": "password",
          "type": "text",
          "visibleWhen": { "field": "TRANSPORT", "value": "local" },
          "placeholder": "{{ device_password }}"
        },
        {
          "fieldId": "VALIDATE_CERTS",
          "label": "Validate Certs",
          "yamlKey": "validate_certs",
          "type": "boolean",
          "default": false,
          "advanced": true
        },
        {
          "fieldId": "TIMEOUT",
          "label": "Timeout",
          "yamlKey": "timeout",
          "type": "number",
          "default": 30,
          "advanced": true
        }
      ]
    },
    {
      "fqcn": "voipnorm.roomos.roomos_status",
      "shortName": "roomos_status",
      "displayName": "RoomOS Status",
      "description": "Query xStatus values for conditional playbook logic",
      "fields": [
        {
          "fieldId": "PATHS",
          "label": "Status Paths",
          "yamlKey": "paths",
          "type": "text",
          "yamlType": "list",
          "required": true,
          "multiline": true,
          "placeholder": "Standby.State\nSystemUnit.Uptime",
          "helpText": "xStatus paths to query (one per line)"
        },
        {
          "fieldId": "ON_MISSING",
          "label": "On Missing",
          "yamlKey": "on_missing",
          "type": "dropdown",
          "default": "warn",
          "choices": ["warn", "fail", "ignore"],
          "helpText": "How to handle paths that don't exist"
        },
        {
          "fieldId": "TRANSPORT",
          "label": "Transport",
          "yamlKey": "transport",
          "type": "dropdown",
