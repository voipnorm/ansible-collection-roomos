          "placeholder": "{{ webex_token }}"
        },
        {
          "fieldId": "HOST",
          "label": "Host",
          "yamlKey": "host",
          "type": "text",
          "visibleWhen": { "field": "TRANSPORT", "value": "local" },
          "placeholder": "{{ ansible_host }}"
        },
        {
          "fieldId": "USERNAME",
          "label": "Username",
          "yamlKey": "username",
          "type": "text",
          "visibleWhen": { "field": "TRANSPORT", "value": "local" },
          "placeholder": "admin"
        },
        {
